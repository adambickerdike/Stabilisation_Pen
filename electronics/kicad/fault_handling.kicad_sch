  (text "ACT_EN = ACT_EN_REQ AND FAULT_N AND NOCHG. Any comparator trip sets the latch (FAULT_N low) and opens VMOT within ~2 us + switch turn-off."
    (exclude_from_sim no)
    (at 20 243.00 0)
    (effects
      (font
        (size 1.6 1.6))
      (justify left bottom))
    (uuid "c8fc856c-3df4-502a-90be-9fc1062580c9"))
  (text "Latch clear sequence (firmware): ACT_EN_REQ low -> pulse FAULT_CLR_N low 1 us -> read FAULT_N high -> ACT_EN_REQ high."
    (exclude_from_sim no)
    (at 20 247.00 0)
    (effects
      (font
        (size 1.6 1.6))
      (justify left bottom))
    (uuid "44940373-55ed-5fe1-a4fb-7d131bad3b2d"))
  (text "Independent watchdog: MCU reset releases ACT_EN_REQ (R71 pull-down) and DRV_SLEEP_N (driver internal pull-down), so VMOT opens."
    (exclude_from_sim no)
    (at 20 251.00 0)
    (effects
      (font
        (size 1.6 1.6))
      (justify left bottom))
    (uuid "ab1a6b18-52c1-500c-95ef-7ffea4f2ee3d"))
