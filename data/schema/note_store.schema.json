{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stabpen:schema:note-store:1",
  "title": "Research pen note store (ICD v1.0 section 4.5)",
  "description": "Immutable, content-addressed original stroke layer plus derived layers with provenance. The root object is an export bundle; each stored object (original_layer, note, derived_layer) is validated on its own against the matching $defs entry. Reference implementation: app/penapp/notes.py. Every value produced by the demo is synthetic.",
  "type": "object",
  "required": ["object", "schema_version", "notes", "originals", "layers"],
  "additionalProperties": false,
  "properties": {
    "object": {"const": "note_store_bundle"},
    "schema_version": {"const": 1},
    "exported_utc": {"$ref": "#/$defs/utc_timestamp"},
    "exported_by": {"$ref": "#/$defs/created_by"},
    "notes": {"type": "array", "items": {"$ref": "#/$defs/note"}},
    "originals": {"type": "array", "items": {"$ref": "#/$defs/original_layer"}},
    "layers": {"type": "array", "items": {"$ref": "#/$defs/derived_layer"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "utc_timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "u8": {"type": "integer", "minimum": 0, "maximum": 255},
    "u16": {"type": "integer", "minimum": 0, "maximum": 65535},
    "u32": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "i32": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647},
    "u64_string": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,19})$",
      "description": "u64 as a decimal string (JSON numbers are exact only up to 2^53)."},
    "note_id": {"type": "string", "pattern": "^note-[0-9a-f]{16}$"},
    "layer_kind": {"enum": ["recognition", "segmentation", "hand_path_estimate", "user_edit", "ai_summary"]},
    "layer_id": {
      "type": "string",
      "pattern": "^(recognition|segmentation|hand_path_estimate|user_edit|ai_summary)-[0-9a-f]{16}$"
    },
    "created_by": {
      "type": "string",
      "pattern": "^(user|[a-z][a-z0-9_.\\-]*@[0-9][0-9A-Za-z.\\-+]*)$",
      "description": "Algorithm id + version as '<id>@<version>', or the literal 'user'."
    },
    "stroke_range": {
      "type": "array",
      "prefixItems": [{"$ref": "#/$defs/u32"}, {"$ref": "#/$defs/u32"}],
      "items": false,
      "minItems": 2,
      "description": "Inclusive [first, last] stroke ids; only consecutive existing ids are merged."
    },
    "stroke_ranges": {"type": "array", "items": {"$ref": "#/$defs/stroke_range"}, "minItems": 1},
    "bbox_um": {
      "type": "array",
      "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}, {"type": "number"}],
      "items": false,
      "minItems": 4,
      "description": "[x_min, y_min, x_max, y_max] in the page frame {P}, micrometres."
    },
    "input_ref": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "sha256"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "original"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "stroke_ranges": {"$ref": "#/$defs/stroke_ranges"}
          }
        },
        {
          "type": "object",
          "required": ["type", "layer_id"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "layer"},
            "layer_id": {"$ref": "#/$defs/layer_id"},
            "span_ids": {"type": "array", "items": {"type": "string"}}
          }
        },
        {
          "type": "object",
          "required": ["type", "sha256", "record_type"],
          "additionalProperties": false,
          "description": "Records of the imported binary log other than the stroke samples (e.g. 0x01 research frames).",
          "properties": {
            "type": {"const": "source_file"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "record_type": {"$ref": "#/$defs/u8"},
            "fields": {"type": "array", "items": {"type": "string"}}
          }
        },
        {
          "type": "object",
          "required": ["type", "sha256", "role"],
          "additionalProperties": false,
          "description": "Any other file that influenced the layer (e.g. a synthetic ground-truth transcript).",
          "properties": {
            "type": {"const": "external_file"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "role": {"type": "string", "minLength": 1},
            "name": {"type": "string"}
          }
        }
      ]
    },
    "stroke_sample_row": {
      "type": "array",
      "description": "One ICD 0x02 stroke sample in raw logged units: t_ms, stroke_id, x_um, y_um, force_mN, theta_raw (0.5 deg), phi_raw (2 deg).",
      "prefixItems": [
        {"$ref": "#/$defs/u32"}, {"$ref": "#/$defs/u32"}, {"$ref": "#/$defs/i32"}, {"$ref": "#/$defs/i32"},
        {"$ref": "#/$defs/u16"}, {"$ref": "#/$defs/u8"}, {"$ref": "#/$defs/u8"}
      ],
      "items": false,
      "minItems": 7
    },
    "original_layer": {
      "type": "object",
      "description": "Immutable original layer: the stroke samples exactly as logged. sha256 = SHA-256 of the concatenated 20-byte ICD 0x02 payloads (little-endian) in log order; readers re-encode the rows and must reject any mismatch.",
      "required": ["object", "schema_version", "icd_version", "sha256", "hash_scope", "n_samples", "columns", "samples"],
      "additionalProperties": false,
      "properties": {
        "object": {"const": "original_layer"},
        "schema_version": {"const": 1},
        "icd_version": {"const": "1.0"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "hash_scope": {"const": "sha256 over concatenated ICD 1.0 section 4.3 stroke-sample payloads (20 B, little-endian) in log order"},
        "n_samples": {"type": "integer", "minimum": 0},
        "columns": {"const": ["t_ms", "stroke_id", "x_um", "y_um", "force_mN", "theta_raw", "phi_raw"]},
        "samples": {"type": "array", "items": {"$ref": "#/$defs/stroke_sample_row"}}
      }
    },
    "note": {
      "type": "object",
      "description": "Write-once note manifest: one logged session linked to its original layer.",
      "required": ["object", "schema_version", "note_id", "original_sha256", "session", "source", "imported_utc", "imported_by", "labels", "events", "annotations", "digest"],
      "additionalProperties": false,
      "properties": {
        "object": {"const": "note"},
        "schema_version": {"const": 1},
        "note_id": {"$ref": "#/$defs/note_id"},
        "original_sha256": {"$ref": "#/$defs/sha256"},
        "session": {
          "type": "object",
          "required": ["format_version", "device_id", "session_id", "start_unix_ms"],
          "additionalProperties": false,
          "properties": {
            "format_version": {"$ref": "#/$defs/u16"},
            "device_id": {"$ref": "#/$defs/u64_string"},
            "session_id": {"$ref": "#/$defs/u64_string"},
            "start_unix_ms": {"type": "integer", "minimum": 0}
          }
        },
        "source": {
          "type": "object",
          "required": ["file_name", "file_sha256", "file_bytes", "parse"],
          "additionalProperties": false,
          "properties": {
            "file_name": {"type": "string"},
            "file_sha256": {"$ref": "#/$defs/sha256"},
            "file_bytes": {"type": "integer", "minimum": 0},
            "parse": {"type": "object"}
          }
        },
        "imported_utc": {"$ref": "#/$defs/utc_timestamp"},
        "imported_by": {"$ref": "#/$defs/created_by"},
        "labels": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["t_us", "code", "name", "arg"],
            "additionalProperties": false,
            "properties": {
              "t_us": {"type": "integer", "minimum": 0, "description": "unwrapped 64-bit microseconds since session start"},
              "code": {"$ref": "#/$defs/u16"},
              "name": {"type": "string"},
              "arg": {"type": "integer"}
            }
          }
        },
        "annotations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["offset"],
            "additionalProperties": false,
            "properties": {
              "offset": {"type": "integer", "minimum": 0},
              "text": {"type": "string"},
              "payload_hex": {"type": "string", "pattern": "^[0-9a-f]*$"}
            }
          }
        },
        "digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "segment_span": {
      "type": "object",
      "required": ["span_id", "level", "stroke_ranges", "bbox_um"],
      "additionalProperties": false,
      "properties": {
        "span_id": {"type": "string", "minLength": 1},
        "level": {"enum": ["line", "word"]},
        "parent": {"type": "string"},
        "stroke_ranges": {"$ref": "#/$defs/stroke_ranges"},
        "bbox_um": {"$ref": "#/$defs/bbox_um"}
      }
    },
    "text_span": {
      "type": "object",
      "description": "Recognised text linked to the strokes it came from.",
      "required": ["span_id", "level", "text", "stroke_ranges", "bbox_um"],
      "additionalProperties": false,
      "properties": {
        "span_id": {"type": "string", "minLength": 1},
        "level": {"enum": ["line", "word"]},
        "parent": {"type": "string"},
        "text": {"type": "string"},
        "stroke_ranges": {"$ref": "#/$defs/stroke_ranges"},
        "bbox_um": {"$ref": "#/$defs/bbox_um"},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    },
    "citation": {
      "type": "object",
      "required": ["source_id", "note_id", "original_sha256", "layer_ids", "span_id", "stroke_ranges", "bbox_um"],
      "additionalProperties": false,
      "properties": {
        "source_id": {"type": "string", "pattern": "^S[0-9]+$"},
        "note_id": {"$ref": "#/$defs/note_id"},
        "original_sha256": {"$ref": "#/$defs/sha256"},
        "layer_ids": {"type": "array", "items": {"$ref": "#/$defs/layer_id"}, "minItems": 1},
        "span_id": {"type": "string"},
        "stroke_ranges": {"$ref": "#/$defs/stroke_ranges"},
        "bbox_um": {"$ref": "#/$defs/bbox_um"}
      }
    },
    "payload_segmentation": {
      "type": "object",
      "required": ["strokes", "spans"],
      "additionalProperties": false,
      "properties": {
        "x_height_um": {"type": ["number", "null"]},
        "strokes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["stroke_id", "i0", "i1", "t0_ms", "t1_ms", "n", "bbox_um", "length_um", "flags"],
            "additionalProperties": false,
            "properties": {
              "stroke_id": {"$ref": "#/$defs/u32"},
              "i0": {"type": "integer", "minimum": 0},
              "i1": {"type": "integer", "minimum": 0},
              "t0_ms": {"type": "integer", "minimum": 0},
              "t1_ms": {"type": "integer", "minimum": 0},
              "n": {"type": "integer", "minimum": 1},
              "bbox_um": {"$ref": "#/$defs/bbox_um"},
              "length_um": {"type": "number", "minimum": 0},
              "flags": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "spans": {"type": "array", "items": {"$ref": "#/$defs/segment_span"}}
      }
    },
    "payload_recognition": {
      "type": "object",
      "required": ["language", "spans", "evidence_status"],
      "additionalProperties": false,
      "properties": {
        "language": {"type": ["string", "null"]},
        "evidence_status": {"type": "string"},
        "spans": {"type": "array", "items": {"$ref": "#/$defs/text_span"}}
      }
    },
    "payload_user_edit": {
      "type": "object",
      "required": ["target_layer", "edits"],
      "additionalProperties": false,
      "properties": {
        "target_layer": {"$ref": "#/$defs/layer_id"},
        "edits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["span_id", "text", "previous_text", "stroke_ranges"],
            "additionalProperties": false,
            "properties": {
              "span_id": {"type": "string"},
              "text": {"type": "string"},
              "previous_text": {"type": "string"},
              "stroke_ranges": {"$ref": "#/$defs/stroke_ranges"}
            }
          }
        }
      }
    },
    "payload_hand_path_estimate": {
      "type": "object",
      "required": ["method", "strokes"],
      "additionalProperties": false,
      "properties": {
        "method": {"type": "string"},
        "evidence_status": {"type": "string"},
        "strokes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["stroke_id", "t_ms", "x_um", "y_um"],
            "additionalProperties": false,
            "properties": {
              "stroke_id": {"$ref": "#/$defs/u32"},
              "t_ms": {"type": "array", "items": {"type": "integer"}},
              "x_um": {"type": "array", "items": {"type": "number"}},
              "y_um": {"type": "array", "items": {"type": "number"}}
            }
          }
        }
      }
    },
    "payload_ai_summary": {
      "type": "object",
      "description": "Assistant output. Every sentence carries at least one citation to note spans and their stroke-id ranges.",
      "required": ["question", "sentences", "sources", "llm", "validation", "disclaimer"],
      "additionalProperties": false,
      "properties": {
        "question": {"type": "string", "minLength": 1},
        "sentences": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["text", "citations", "support"],
            "additionalProperties": false,
            "properties": {
              "text": {"type": "string", "minLength": 1},
              "citations": {"type": "array", "items": {"$ref": "#/$defs/citation"}, "minItems": 1},
              "support": {"type": "number", "minimum": 0, "maximum": 1}
            }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["source_id", "note_id", "layer_ids", "span_id", "text", "stroke_ranges", "bbox_um", "score"],
            "additionalProperties": false,
            "properties": {
              "source_id": {"type": "string", "pattern": "^S[0-9]+$"},
              "note_id": {"$ref": "#/$defs/note_id"},
              "layer_ids": {"type": "array", "items": {"$ref": "#/$defs/layer_id"}, "minItems": 1},
              "span_id": {"type": "string"},
              "text": {"type": "string"},
              "stroke_ranges": {"$ref": "#/$defs/stroke_ranges"},
              "bbox_um": {"$ref": "#/$defs/bbox_um"},
              "score": {"type": "number"}
            }
          }
        },
        "llm": {
          "type": "object",
          "required": ["model_id", "version", "local", "deterministic"],
          "additionalProperties": false,
          "properties": {
            "model_id": {"type": "string"},
            "version": {"type": "string"},
            "local": {"type": "boolean"},
            "deterministic": {"type": "boolean"}
          }
        },
        "validation": {"type": "object"},
        "disclaimer": {"type": "string", "minLength": 1}
      }
    },
    "derived_layer": {
      "type": "object",
      "description": "Write-once derived layer. layer_id = '<kind>-' + first 16 hex of SHA-256 over the canonical JSON of {kind, note_ids, created_by, inputs, params, payload}; digest = SHA-256 of the canonical JSON of the whole object without 'digest'.",
      "required": ["object", "schema_version", "layer_id", "kind", "note_ids", "created_by", "created_utc", "inputs", "params", "payload", "digest"],
      "additionalProperties": false,
      "properties": {
        "object": {"const": "derived_layer"},
        "schema_version": {"const": 1},
        "layer_id": {"$ref": "#/$defs/layer_id"},
        "kind": {"$ref": "#/$defs/layer_kind"},
        "note_ids": {"type": "array", "items": {"$ref": "#/$defs/note_id"}, "minItems": 1, "uniqueItems": true},
        "created_by": {"$ref": "#/$defs/created_by"},
        "created_utc": {"$ref": "#/$defs/utc_timestamp"},
        "inputs": {"type": "array", "items": {"$ref": "#/$defs/input_ref"}, "minItems": 1},
        "params": {"type": "object"},
        "payload": {"type": "object"},
        "digest": {"$ref": "#/$defs/sha256"}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "segmentation"}}},
         "then": {"properties": {"payload": {"$ref": "#/$defs/payload_segmentation"}}}},
        {"if": {"properties": {"kind": {"const": "recognition"}}},
         "then": {"properties": {"payload": {"$ref": "#/$defs/payload_recognition"}}}},
        {"if": {"properties": {"kind": {"const": "user_edit"}}},
         "then": {"properties": {"payload": {"$ref": "#/$defs/payload_user_edit"}, "created_by": {"const": "user"}}}},
        {"if": {"properties": {"kind": {"const": "hand_path_estimate"}}},
         "then": {"properties": {"payload": {"$ref": "#/$defs/payload_hand_path_estimate"}}}},
        {"if": {"properties": {"kind": {"const": "ai_summary"}}},
         "then": {"properties": {"payload": {"$ref": "#/$defs/payload_ai_summary"},
                                 "created_by": {"not": {"const": "user"}}}}}
      ]
    }
  }
}
